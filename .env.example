# Copy to .env.local and fill in. Never commit real values — .env* is gitignored.

# --- reCAPTCHA v3 ---------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com

# --- n8n webhooks ---------------------------------------------------------
# Production webhook URL for each automation.
N8N_WEBHOOK_URL=
N8N_NEWSLETTER_WEBHOOK_URL=

# Shared secret sent as the `X-Webhook-Secret` header on every call above.
# Must match the n8n "Header Auth" credential attached to each Webhook node.
# Generate with: openssl rand -hex 32
# Required — the API routes fail closed (HTTP 500) if this is unset.
N8N_WEBHOOK_SECRET=
